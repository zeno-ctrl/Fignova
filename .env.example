# ---- AutoFigure Studio configuration (copy to .env; never commit real secrets) ----
# Where the SQLite metadata DB and the encrypted object store live (mount a persistent volume here).
AUTOFIGURE_DATA_DIR=/var/lib/autofigure
# 32 random bytes, base64url. Generate: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Encrypts stored documents (AES-256-GCM) and the owner's TOTP seed. Losing it makes stored files unreadable.
AUTOFIGURE_ENCRYPTION_KEY=
# The single owner principal (verified creator). Only used by `python -m autofigure owner-invite`.
AUTOFIGURE_OWNER_EMAIL=
AUTOFIGURE_OWNER_NAME=Zaw Naing Oo
# Public URL (used for enrollment links and the CSRF origin check)
AUTOFIGURE_PUBLIC_URL=https://autofigure.example.com
# true behind HTTPS (Secure cookies + HSTS)
AUTOFIGURE_SECURE_COOKIES=true
AUTOFIGURE_MAX_UPLOAD_MB=50
AUTOFIGURE_RETENTION_DAYS=30
# ---- AutoFigure AI ----
# autofigure (default): built-in document-context analysis + every vision model configured below, cross-checked.
# anthropic | openai: one external model only.  none: offline document-context analysis only.
AUTOFIGURE_AI_PROVIDER=autofigure
ANTHROPIC_API_KEY=
AUTOFIGURE_AI_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# Set to a current vision-capable OpenAI model available to your account.
AUTOFIGURE_OPENAI_MODEL=gpt-4o
# Comma list to temporarily disable a configured provider: anthropic,openai
AUTOFIGURE_AI_DISABLE=
AUTOFIGURE_AI_MAX_FIGURES=150
# ---- Rendering / workers ----
AUTOFIGURE_RENDER_TIMEOUT=180
# auto (use `unshare -rn` when available) | unshare (require it) | none
AUTOFIGURE_RENDER_SANDBOX=auto
AUTOFIGURE_WORKER_CONCURRENCY=2
# ---- Disclosure details shown on the privacy page ----
AUTOFIGURE_OPERATOR_NAME=
AUTOFIGURE_SUPPORT_CONTACT=
AUTOFIGURE_STORAGE_REGION=
